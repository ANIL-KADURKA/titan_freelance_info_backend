generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  NOT_ELIGIBLE
}

enum RoleName {
  ADMIN
  RECRUITER
  EMPLOYEE
  CANDIDATE
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum GenderEnum {
  MALE
  FEMALE
  OTHERS
  NOT_DISCLOSED
}

enum AddressType {
  CURRENT
  PERMANENT
  OTHER
}

enum ConsentType {
  MARKETING_EMAILS
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
}

enum SocialMediaType {
  LINKEDIN
  GITHUB
  TWITTER
  INSTAGRAM
  FACEBOOK
  PORTFOLIO
  OTHER
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum OtpPurpose {
  LOGIN
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum ApplicationFieldType {
  TEXT
  SHORT_TEXT
  NUMBER
  EMAIL
  URL
  SELECT
  MULTI_SELECT
  DATE
  FILE
  CHECKBOX
}

enum EligibilityFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum EligibilityOperator {
  EQ
  NE
  GT
  LT
  GTE
  LTE
  IN
  NOT_IN
  EXISTS
  CONTAINS
}

enum ApplicationStatus {
  APPLIED
  IN_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WebsiteScreen {
  HOME
  ABOUT
  JOBS
  CONTACT
  FAQ
  TESTIMONIALS
  CASE_STUDIES
  ANNOUNCEMENTS
}

model WebsiteContent {
  id        String        @id @default(uuid())
  screenKey WebsiteScreen @unique @map("screen_key")
  content   Json
  version   Int           @default(1)
  updatedBy String?       @map("updated_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("website_content")
}

model FaqCategory {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz()

  faqs Faq[]

  @@index([status, sortOrder])
  @@map("faq_categories")
}

model Faq {
  id            String        @id @default(uuid()) @db.Uuid
  question      String
  answer        String
  category      String?
  faqCategoryId String?       @map("faq_category_id") @db.Uuid
  sortOrder     Int           @default(0) @map("sort_order")
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz()

  faqCategory FaqCategory? @relation(fields: [faqCategoryId], references: [id])

  @@index([status, sortOrder])
  @@map("faqs")
}

model User {
  id                      String        @id @default(uuid()) @db.Uuid
  email                   String        @unique @db.VarChar(320)
  personalEmail           String        @unique @map("personal_email") @db.VarChar(320)
  phone                   String?       @db.VarChar(20)
  firstName               String?       @map("first_name")
  lastName                String?       @map("last_name")
  gender                  GenderEnum?
  whatsappNumber          String?       @map("whatsapp_number") @db.VarChar(20)
  dateOfBirth             DateTime?     @map("date_of_birth") @db.Date
  profileImageId          String?       @map("profile_image_id") @db.Uuid
  passwordHash            String        @map("password_hash")
  status                  AccountStatus @default(PENDING_VERIFICATION)
  statusReason            String?       @map("status_reason")
  emailVerifiedAt         DateTime?     @map("email_verified_at") @db.Timestamptz()
  failedLoginCount        Int           @default(0) @map("failed_login_count")
  lockedUntil             DateTime?     @map("locked_until") @db.Timestamptz()
  lastLoginAt             DateTime?     @map("last_login_at") @db.Timestamptz()
  lastLoginIp             String?       @map("last_login_ip")
  announcementEmailOptOut Boolean       @default(false) @map("announcement_email_opt_out")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz()
  additionalDetails       Json?         @map("additional_details")

  addresses                    UserAddress[]
  educations                   UserEducation[]
  socialLinks                  UserSocialMediaLink[]
  professionalInfo             UserProfessionalInfo?
  roles                        UserRole[]
  sessions                     Session[]
  authOtps                     AuthOtp[]
  consentRecords               ConsentRecord[]
  uploadedFiles                FileObject[]               @relation("UploadedByUser")
  createdJobs                  Job[]                      @relation("CreatedJobs")
  applications                 CandidateApplication[]     @relation("CandidateApplications")
  assignedApplications         CandidateApplication[]     @relation("AssignedApplications")
  applicationStatusChanges     ApplicationStatusHistory[] @relation("ApplicationStatusChangedBy")
  verifiedApplicationDocuments JobApplicationDocument[]   @relation("DocumentVerifiedBy")
  candidateProfileValues       CandidateProfileValue[]
  candidateProfileDocuments    CandidateProfileDocument[]

  @@index([status])
  @@map("users")
}

model JobCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique @db.VarChar(200)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  jobs Job[]

  @@index([isActive, sortOrder])
  @@map("job_categories")
}

model Job {
  id                      String    @id @default(uuid()) @db.Uuid
  slug                    String    @unique @db.VarChar(200)
  title                   String
  categoryId              String    @map("category_id") @db.Uuid
  createdById             String    @map("created_by_id") @db.Uuid
  summary                 String?
  description             String
  skills                  String[]  @default([])
  requirements            String[]  @default([])
  location                String?
  workMode                WorkMode  @default(REMOTE) @map("work_mode")
  duration                String?
  openings                Int?
  applicationInstructions String[]  @default([]) @map("application_instructions")
  workInstructions        String[]  @default([]) @map("work_instructions")
  additionalInfo          Json?     @map("additional_info")
  coverImageId            String?   @map("cover_image_id") @db.Uuid
  status                  JobStatus @default(DRAFT)
  publishedAt             DateTime? @map("published_at") @db.Timestamptz()
  applicationDeadline     DateTime? @map("application_deadline") @db.Timestamptz()
  closedAt                DateTime? @map("closed_at") @db.Timestamptz()
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz()

  category          JobCategory            @relation(fields: [categoryId], references: [id])
  createdBy         User                   @relation("CreatedJobs", fields: [createdById], references: [id])
  applicationFields JobApplicationField[]
  eligibilityRules  JobEligibilityRule[]
  applications      CandidateApplication[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([createdById])
  @@index([applicationDeadline])
  @@index([deletedAt])
  @@map("jobs")
}

model JobApplicationField {
  id             String               @id @default(uuid()) @db.Uuid
  jobId          String               @map("job_id") @db.Uuid
  fieldKey       String               @map("field_key") @db.VarChar(100)
  fieldType      ApplicationFieldType @map("field_type")
  label          String               @db.VarChar(200)
  description    String?
  required       Boolean              @default(false)
  displayOrder   Int                  @default(0) @map("display_order")
  options        Json?
  documentTypeId String?              @map("document_type_id") @db.Uuid
  profileFieldId String?              @map("profile_field_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz()

  job          Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentType DocumentType?              @relation(fields: [documentTypeId], references: [id])
  profileField CandidateProfileField?     @relation(fields: [profileFieldId], references: [id], onDelete: SetNull)
  fieldValues  JobApplicationFieldValue[]

  @@unique([jobId, fieldKey])
  @@index([jobId, displayOrder])
  @@index([documentTypeId])
  @@index([profileFieldId])
  @@map("job_application_fields")
}

model CandidateApplication {
  id              String            @id @default(uuid()) @db.Uuid
  applicationNo   String            @unique @map("application_no") @db.VarChar(30)
  userId          String            @map("user_id") @db.Uuid
  jobId           String            @map("job_id") @db.Uuid
  status          ApplicationStatus @default(APPLIED)
  statusChangedAt DateTime          @default(now()) @map("status_changed_at") @db.Timestamptz()
  coverNote       String?           @map("cover_note")
  rejectionReason String?           @map("rejection_reason")
  withdrawnReason String?           @map("withdrawn_reason")
  assignedToId    String?           @map("assigned_to_id") @db.Uuid
  source          String?
  appliedAt       DateTime          @default(now()) @map("applied_at") @db.Timestamptz()
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz()

  candidate  User  @relation("CandidateApplications", fields: [userId], references: [id])
  job        Job   @relation(fields: [jobId], references: [id])
  assignedTo User? @relation("AssignedApplications", fields: [assignedToId], references: [id], onDelete: SetNull)

  statusHistory ApplicationStatusHistory[]
  documents     JobApplicationDocument[]
  fieldValues   JobApplicationFieldValue[]

  @@unique([userId, jobId])
  @@index([jobId, status])
  @@index([status, statusChangedAt])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedById   String?            @map("changed_by_id") @db.Uuid
  comment       String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?                @relation("ApplicationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model DocumentType {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique @db.VarChar(100)
  name                String   @db.VarChar(200)
  description         String?
  allowedMimeTypes    String[] @default([]) @map("allowed_mime_types")
  maxSizeBytes        Int?     @map("max_size_bytes")
  sensitive           Boolean  @default(false)
  allowCandidateReuse Boolean  @default(false) @map("allow_candidate_reuse")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  applicationFields    JobApplicationField[]
  applicationDocuments JobApplicationDocument[]
  candidateDocuments   CandidateProfileDocument[]

  @@map("document_types")
}

model JobApplicationDocument {
  id                  String                     @id @default(uuid()) @db.Uuid
  applicationId       String                     @map("application_id") @db.Uuid
  documentTypeId      String                     @map("document_type_id") @db.Uuid
  fileObjectId        String                     @map("file_object_id") @db.Uuid
  candidateDocumentId String?                    @map("candidate_document_id") @db.Uuid
  fieldKey            String?                    @map("field_key") @db.VarChar(100)
  version             Int                        @default(1)
  isCurrent           Boolean                    @default(true) @map("is_current")
  verificationStatus  DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt          DateTime?                  @map("verified_at") @db.Timestamptz()
  verifiedById        String?                    @map("verified_by_id") @db.Uuid
  verificationComment String?                    @map("verification_comment")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()

  application       CandidateApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType      DocumentType              @relation(fields: [documentTypeId], references: [id])
  fileObject        FileObject                @relation(fields: [fileObjectId], references: [id])
  candidateDocument CandidateProfileDocument? @relation(fields: [candidateDocumentId], references: [id], onDelete: SetNull)
  verifiedBy        User?                     @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([applicationId, fieldKey])
  @@index([documentTypeId])
  @@index([fileObjectId])
  @@index([candidateDocumentId])
  @@map("job_application_documents")
}

model CandidateProfileField {
  id          String               @id @default(uuid()) @db.Uuid
  key         String               @unique @db.VarChar(100)
  label       String               @db.VarChar(200)
  description String?
  fieldType   ApplicationFieldType @map("field_type")
  isSensitive Boolean              @default(false) @map("is_sensitive")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  values    CandidateProfileValue[]
  jobFields JobApplicationField[]

  @@map("candidate_profile_fields")
}

model CandidateProfileValue {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  field CandidateProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@map("candidate_profile_values")
}

model CandidateProfileDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String                     @map("user_id") @db.Uuid
  documentTypeId     String                     @map("document_type_id") @db.Uuid
  fileObjectId       String                     @unique @map("file_object_id") @db.Uuid
  version            Int                        @default(1)
  isCurrent          Boolean                    @default(true) @map("is_current")
  expiresAt          DateTime?                  @map("expires_at") @db.Timestamptz()
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz()
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()

  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType         DocumentType             @relation(fields: [documentTypeId], references: [id])
  fileObject           FileObject               @relation(fields: [fileObjectId], references: [id])
  applicationDocuments JobApplicationDocument[]

  @@index([userId, documentTypeId, isCurrent])
  @@map("candidate_profile_documents")
}

model JobApplicationFieldValue {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  fieldId       String   @map("field_id") @db.Uuid
  value         Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       JobApplicationField  @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([applicationId, fieldId])
  @@index([fieldId])
  @@map("job_application_field_values")
}

model JobEligibilityRule {
  id           String               @id @default(uuid()) @db.Uuid
  jobId        String               @map("job_id") @db.Uuid
  fieldKey     String               @map("field_key") @db.VarChar(100)
  fieldType    EligibilityFieldType @map("field_type")
  operator     EligibilityOperator
  value        Json
  displayOrder Int                  @default(0) @map("display_order")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz()

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, displayOrder])
  @@index([jobId, fieldKey])
  @@map("job_eligibility_rules")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(100)
  module      String  @db.VarChar(60)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthOtp {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  purpose     OtpPurpose
  otpHash     String     @map("otp_hash") @db.VarChar(255)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz()
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz()
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otps")
}

model ConsentRecord {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  type        ConsentType
  version     String      @db.VarChar(30)
  grantedAt   DateTime    @default(now()) @map("granted_at") @db.Timestamptz()
  withdrawnAt DateTime?   @map("withdrawn_at") @db.Timestamptz()
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("consent_records")
}

model FileObject {
  id             String         @id @default(uuid()) @db.Uuid
  bucket         String         @db.VarChar(100)
  objectKey      String         @map("object_key")
  originalName   String         @map("original_name")
  mimeType       String         @map("mime_type") @db.VarChar(150)
  sizeBytes      BigInt         @map("size_bytes")
  checksumSha256 String?        @map("checksum_sha256") @db.VarChar(64)
  visibility     FileVisibility @default(PRIVATE)
  scanStatus     FileScanStatus @default(PENDING) @map("scan_status")
  scannedAt      DateTime?      @map("scanned_at") @db.Timestamptz()
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz()

  uploadedBy                User?                      @relation("UploadedByUser", fields: [uploadedById], references: [id])
  testimonials              Testimonial[]              @relation("TestimonialPhoto")
  applicationDocuments      JobApplicationDocument[]
  candidateProfileDocuments CandidateProfileDocument[]

  @@unique([bucket, objectKey])
  @@index([uploadedById])
  @@index([scanStatus])
  @@map("file_objects")
}

model Testimonial {
  id         String        @id @default(uuid()) @db.Uuid
  authorName String        @map("author_name")
  authorRole String?       @map("author_role")
  quote      String
  joinedAt   DateTime?     @map("joined_at") @db.Date
  photoId    String?       @map("photo_id") @db.Uuid
  status     PublishStatus @default(DRAFT)
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz()

  photo FileObject? @relation("TestimonialPhoto", fields: [photoId], references: [id])

  @@index([status, sortOrder])
  @@map("testimonials")
}

model UserAddress {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  addressType AddressType @default(CURRENT) @map("address_type")
  addressLine String?     @map("address_line")
  city        String?
  state       String?
  country     String      @default("India")
  postalCode  String?     @map("postal_code") @db.VarChar(12)
  isPrimary   Boolean     @default(false) @map("is_primary")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId, addressType])
  @@map("user_addresses")
}

model UserEducation {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  institution  String
  degree       String?
  fieldOfStudy String?   @map("field_of_study")
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  grade        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_educations")
}

model UserSocialMediaLink {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  socialMediaType SocialMediaType @map("social_media_type")
  url             String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_social_media_links")
}

model UserProfessionalInfo {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  languages         String[]
  hardSkills        String[] @map("hard_skills")
  softSkills        String[] @map("soft_skills")
  currentOccupation String?  @map("current_occupation")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("user_professional_info")
}
