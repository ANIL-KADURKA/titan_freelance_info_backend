model UserProfessionalInfo {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  languages         String[]
  hardSkills        String[] @map("hard_skills")
  softSkills        String[] @map("soft_skills")
  currentOccupation String?  @map("current_occupation")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@map("user_professional_info")
}

enum PaymentMethodType {
  UPI
  BANK
}

enum PaymentMethodStatus {
  VERIFICATION_PENDING
  VERIFIED
  REJECTED
}

/// Where a freelancer receives payouts. Admins verify each method before use.
model UserPaymentMethod {
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @map("user_id") @db.Uuid
  type                   PaymentMethodType
  status                 PaymentMethodStatus @default(VERIFICATION_PENDING)
  upiId                  String?             @map("upi_id") @db.VarChar(256)
  accountHolderName      String?             @map("account_holder_name") @db.VarChar(120)
  /// AES-256-GCM ciphertext; never returned to the candidate.
  accountNumberEncrypted String?             @map("account_number_encrypted")
  accountNumberLast4     String?             @map("account_number_last4") @db.VarChar(4)
  ifsc                   String?             @db.VarChar(11)
  /// HMAC of the normalised UPI ID / account+IFSC, used to block duplicates.
  fingerprint            String              @db.VarChar(64)
  rejectionReason        String?             @map("rejection_reason") @db.VarChar(500)
  reviewedById           String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt             DateTime?           @map("reviewed_at") @db.Timestamptz()
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz()

  user       User     @relation("UserPaymentMethods", fields: [userId], references: [id])
  reviewedBy User?    @relation("ReviewedPaymentMethods", fields: [reviewedById], references: [id])
  payouts    Payout[]

  @@index([userId, deletedAt])
  @@index([status, createdAt])
  @@index([userId, fingerprint])
  @@map("user_payment_methods")
}
