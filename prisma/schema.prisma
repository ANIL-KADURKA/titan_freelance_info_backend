model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(100)
  module      String  @db.VarChar(60)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthOtp {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  purpose     OtpPurpose
  otpHash     String     @map("otp_hash") @db.VarChar(255)
  target      String?    @db.VarChar(320)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz()
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz()
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_otps")
}

model ConsentRecord {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          ConsentType
  version       String      @db.VarChar(30)
  signatureName String?     @map("signature_name")
  grantedAt     DateTime    @default(now()) @map("granted_at") @db.Timestamptz()
  withdrawnAt   DateTime?   @map("withdrawn_at") @db.Timestamptz()
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  /// The exact agreement text that was signed (trainer agreement only).
  agreementId   String?     @map("agreement_id") @db.Uuid

  user      User       @relation(fields: [userId], references: [id])
  agreement Agreement? @relation(fields: [agreementId], references: [id])

  @@index([userId, type])
  @@index([agreementId])
  @@map("consent_records")
}

/// Every published version of the trainer agreement; the highest
/// (major, minor) is current. A new major version requires re-signing.
model Agreement {
  id          String   @id @default(uuid()) @db.Uuid
  major       Int
  minor       Int
  title       String   @db.VarChar(200)
  body        String
  changeNote  String?  @map("change_note") @db.VarChar(300)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  createdBy  User?           @relation("AgreementsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  signatures ConsentRecord[]

  @@unique([major, minor])
  @@map("agreements")
}

model FileObject {
  id             String         @id @default(uuid()) @db.Uuid
  bucket         String         @db.VarChar(100)
  objectKey      String         @map("object_key")
  originalName   String         @map("original_name")
  mimeType       String         @map("mime_type") @db.VarChar(150)
  sizeBytes      BigInt         @map("size_bytes")
  checksumSha256 String?        @map("checksum_sha256") @db.VarChar(64)
  visibility     FileVisibility @default(PRIVATE)
  scanStatus     FileScanStatus @default(PENDING) @map("scan_status")
  scannedAt      DateTime?      @map("scanned_at") @db.Timestamptz()
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz()

  uploadedBy                User?                      @relation("UploadedByUser", fields: [uploadedById], references: [id])
  testimonials              Testimonial[]              @relation("TestimonialPhoto")
  applicationDocuments      JobApplicationDocument[]
  candidateProfileDocuments CandidateProfileDocument[]
  jobResources              JobResource[]
  payoutProofs              Payout[]                   @relation("PayoutProof")
  timesheetProofs           TimesheetEntry[]           @relation("TimesheetProof")

  @@unique([bucket, objectKey])
  @@index([uploadedById])
  @@index([scanStatus])
  @@map("file_objects")
}

/// Training material attached to a job: an uploaded file (PDF, video, image,
/// audio, document) or an external URL (YouTube, link).
model JobResource {
  id           String          @id @default(uuid()) @db.Uuid
  jobId        String          @map("job_id") @db.Uuid
  type         JobResourceType
  title        String          @db.VarChar(200)
  description  String?
  fileId       String?         @map("file_id") @db.Uuid
  url          String?
  required     Boolean         @default(false)
  displayOrder Int             @default(0) @map("display_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  job  Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file FileObject? @relation(fields: [fileId], references: [id])

  @@index([jobId, displayOrder])
  @@index([fileId])
  @@map("job_resources")
}

model Testimonial {
