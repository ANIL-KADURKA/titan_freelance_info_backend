generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Runtime: Supabase transaction pooler (port 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  /// Migrations: session pooler / direct connection (port 5432).
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  NOT_ELIGIBLE
}

enum RoleName {
  ADMIN
  RECRUITER
  EMPLOYEE
  CANDIDATE
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum GenderEnum {
  MALE
  FEMALE
  OTHERS
  NOT_DISCLOSED
}

enum AddressType {
  CURRENT
  PERMANENT
  OTHER
}

enum ConsentType {
  MARKETING_EMAILS
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  TRAINER_AGREEMENT
}

enum SocialMediaType {
  LINKEDIN
  GITHUB
  TWITTER
  INSTAGRAM
  FACEBOOK
  PORTFOLIO
  OTHER
}

enum FileVisibility {
  PRIVATE
  PUBLIC
}

enum JobResourceType {
  PDF
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
  YOUTUBE
  LINK
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_STATUS
  APPLICATION_SELECTED
  APPLICATION_RECEIVED
  APPLICATION_WITHDRAWN
  PAYMENT_METHOD_SUBMITTED
  PAYMENT_METHOD_REVIEWED
  ACCOUNT_SECURITY
  WELCOME
  CANDIDATE_JOINED
  TIMESHEET_SUBMITTED
  TIMESHEET_REVIEWED
  PAYOUT_SENT
  COMMUNITY_POST
  AGREEMENT_UPDATED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum AnnouncementType {
  ANNOUNCEMENT
  NEW_PROJECT
}

/// Tag shown on community posts (e.g. "Task update").
enum AnnouncementCategory {
  GENERAL
  TASK_UPDATE
  PAYMENT_UPDATE
  PLATFORM_UPDATE
  EVENT
}

enum ReactionType {
  LIKE
  LOVE
}

enum TimesheetStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum OtpPurpose {
  LOGIN
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum PayCurrency {
  INR
  USD
}

enum PayUnit {
  HOUR
  DAY
  WEEK
  MONTH
  TASK
  PROJECT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
}

enum ApplicationFieldType {
  TEXT
  SHORT_TEXT
  NUMBER
  EMAIL
  URL
  SELECT
  MULTI_SELECT
  DATE
  FILE
  CHECKBOX
}

enum EligibilityFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum EligibilityOperator {
  EQ
  NE
  GT
  LT
  GTE
  LTE
  IN
  NOT_IN
  EXISTS
  CONTAINS
}

enum ApplicationStatus {
  APPLIED
  IN_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  COMPLETED
  REJECTED
  WITHDRAWN
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WebsiteScreen {
  HOME
  ABOUT
  JOBS
  CONTACT
  FAQ
  TESTIMONIALS
  CASE_STUDIES
  ANNOUNCEMENTS
}

model WebsiteContent {
  id        String        @id @default(uuid())
  screenKey WebsiteScreen @unique @map("screen_key")
  content   Json
  version   Int           @default(1)
  updatedBy String?       @map("updated_by")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("website_content")
}

model FaqCategory {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz()

  faqs Faq[]

  @@index([status, sortOrder])
  @@map("faq_categories")
}

model Faq {
  id            String        @id @default(uuid()) @db.Uuid
  question      String
  answer        String
  category      String?
  faqCategoryId String?       @map("faq_category_id") @db.Uuid
  sortOrder     Int           @default(0) @map("sort_order")
  status        PublishStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz()

  faqCategory FaqCategory? @relation(fields: [faqCategoryId], references: [id])

  @@index([status, sortOrder])
  @@map("faqs")
}

model User {
  id                      String        @id @default(uuid()) @db.Uuid
  email                   String        @unique @db.VarChar(320)
  personalEmail           String        @unique @map("personal_email") @db.VarChar(320)
  phone                   String?       @db.VarChar(20)
  phoneVerifiedAt         DateTime?     @map("phone_verified_at") @db.Timestamptz()
  legalName               String?       @map("legal_name")
  referralSource          String?       @map("referral_source") @db.VarChar(60)
  onboardingCompletedAt   DateTime?     @map("onboarding_completed_at") @db.Timestamptz()
  firstName               String?       @map("first_name")
  lastName                String?       @map("last_name")
  gender                  GenderEnum?
  whatsappNumber          String?       @map("whatsapp_number") @db.VarChar(20)
  dateOfBirth             DateTime?     @map("date_of_birth") @db.Date
  profileImageId          String?       @map("profile_image_id") @db.Uuid
  passwordHash            String        @map("password_hash")
  status                  AccountStatus @default(PENDING_VERIFICATION)
  statusReason            String?       @map("status_reason")
  emailVerifiedAt         DateTime?     @map("email_verified_at") @db.Timestamptz()
  failedLoginCount        Int           @default(0) @map("failed_login_count")
  tokenVersion            Int           @default(0) @map("token_version")
  lockedUntil             DateTime?     @map("locked_until") @db.Timestamptz()
  lastLoginAt             DateTime?     @map("last_login_at") @db.Timestamptz()
  lastLoginIp             String?       @map("last_login_ip")
  announcementEmailOptOut Boolean       @default(false) @map("announcement_email_opt_out")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz()
  additionalDetails       Json?         @map("additional_details")

  addresses                    UserAddress[]
  educations                   UserEducation[]
  socialLinks                  UserSocialMediaLink[]
  professionalInfo             UserProfessionalInfo?
  roles                        UserRole[]
  sessions                     Session[]
  authOtps                     AuthOtp[]
  consentRecords               ConsentRecord[]
  uploadedFiles                FileObject[]               @relation("UploadedByUser")
  createdJobs                  Job[]                      @relation("CreatedJobs")
  applications                 CandidateApplication[]     @relation("CandidateApplications")
  assignedApplications         CandidateApplication[]     @relation("AssignedApplications")
  applicationStatusChanges     ApplicationStatusHistory[] @relation("ApplicationStatusChangedBy")
  workAccountsSent             ApplicationWorkAccount[]   @relation("WorkAccountsSent")
  notifications                Notification[]
  verifiedApplicationDocuments JobApplicationDocument[]   @relation("DocumentVerifiedBy")
  candidateProfileValues       CandidateProfileValue[]
  candidateProfileDocuments    CandidateProfileDocument[]
  paymentMethods               UserPaymentMethod[]        @relation("UserPaymentMethods")
  reviewedPaymentMethods       UserPaymentMethod[]        @relation("ReviewedPaymentMethods")
  timesheetEntries             TimesheetEntry[]           @relation("TimesheetEntries")
  timesheetsReviewed           TimesheetEntry[]           @relation("TimesheetsReviewed")
  payoutsReceived              Payout[]                   @relation("PayoutsReceived")
  payoutsSent                  Payout[]                   @relation("PayoutsSent")
  announcementsCreated         Announcement[]             @relation("AnnouncementsCreated")
  agreementsCreated            Agreement[]                @relation("AgreementsCreated")
  announcementReactions        AnnouncementReaction[]     @relation("AnnouncementReactions")

  @@index([status])
  @@map("users")
}

model JobCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique @db.VarChar(200)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  jobs Job[]

  @@index([isActive, sortOrder])
  @@map("job_categories")
}

model Job {
  id                      String       @id @default(uuid()) @db.Uuid
  slug                    String       @unique @db.VarChar(200)
  title                   String
  categoryId              String       @map("category_id") @db.Uuid
  createdById             String       @map("created_by_id") @db.Uuid
  summary                 String?
  description             String
  skills                  String[]     @default([])
  requirements            String[]     @default([])
  location                String?
  workMode                WorkMode     @default(REMOTE) @map("work_mode")
  duration                String?
  openings                Int?
  payAmount               Decimal?     @map("pay_amount") @db.Decimal(12, 2)
  payCurrency             PayCurrency? @map("pay_currency")
  payUnit                 PayUnit?     @map("pay_unit")
  applicationInstructions String[]     @default([]) @map("application_instructions")
  workInstructions        String[]     @default([]) @map("work_instructions")
  additionalInfo          Json?        @map("additional_info")
  coverImageId            String?      @map("cover_image_id") @db.Uuid
  status                  JobStatus    @default(DRAFT)
  publishedAt             DateTime?    @map("published_at") @db.Timestamptz()
  applicationDeadline     DateTime?    @map("application_deadline") @db.Timestamptz()
  closedAt                DateTime?    @map("closed_at") @db.Timestamptz()
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt               DateTime?    @map("deleted_at") @db.Timestamptz()

  category          JobCategory            @relation(fields: [categoryId], references: [id])
  createdBy         User                   @relation("CreatedJobs", fields: [createdById], references: [id])
  applicationFields JobApplicationField[]
  eligibilityRules  JobEligibilityRule[]
  applications      CandidateApplication[]
  resources         JobResource[]
  timesheetEntries  TimesheetEntry[]
  announcements     Announcement[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([createdById])
  @@index([applicationDeadline])
  @@index([deletedAt])
  @@map("jobs")
}

model JobApplicationField {
  id             String               @id @default(uuid()) @db.Uuid
  jobId          String               @map("job_id") @db.Uuid
  fieldKey       String               @map("field_key") @db.VarChar(100)
  fieldType      ApplicationFieldType @map("field_type")
  label          String               @db.VarChar(200)
  description    String?
  required       Boolean              @default(false)
  displayOrder   Int                  @default(0) @map("display_order")
  options        Json?
  documentTypeId String?              @map("document_type_id") @db.Uuid
  profileFieldId String?              @map("profile_field_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz()

  job          Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentType DocumentType?              @relation(fields: [documentTypeId], references: [id])
  profileField CandidateProfileField?     @relation(fields: [profileFieldId], references: [id], onDelete: SetNull)
  fieldValues  JobApplicationFieldValue[]

  @@unique([jobId, fieldKey])
  @@index([jobId, displayOrder])
  @@index([documentTypeId])
  @@index([profileFieldId])
  @@map("job_application_fields")
}

model CandidateApplication {
  id                 String            @id @default(uuid()) @db.Uuid
  applicationNo      String            @unique @map("application_no") @db.VarChar(30)
  userId             String            @map("user_id") @db.Uuid
  jobId              String            @map("job_id") @db.Uuid
  status             ApplicationStatus @default(APPLIED)
  statusChangedAt    DateTime          @default(now()) @map("status_changed_at") @db.Timestamptz()
  coverNote          String?           @map("cover_note")
  /// Snapshot of the candidate's eligibility answers and the rule results.
  eligibilityAnswers Json?             @map("eligibility_answers")
  rejectionReason    String?           @map("rejection_reason")
  withdrawnReason    String?           @map("withdrawn_reason")
  assignedToId       String?           @map("assigned_to_id") @db.Uuid
  source             String?
  appliedAt          DateTime          @default(now()) @map("applied_at") @db.Timestamptz()
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz()

  candidate  User  @relation("CandidateApplications", fields: [userId], references: [id])
  job        Job   @relation(fields: [jobId], references: [id])
  assignedTo User? @relation("AssignedApplications", fields: [assignedToId], references: [id], onDelete: SetNull)

  statusHistory    ApplicationStatusHistory[]
  documents        JobApplicationDocument[]
  workAccount      ApplicationWorkAccount?
  fieldValues      JobApplicationFieldValue[]
  timesheetEntries TimesheetEntry[]

  @@unique([userId, jobId])
  @@index([jobId, status])
  @@index([status, statusChangedAt])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("applications")
}

/// Work account emailed to a selected candidate. The password is encrypted
/// (AES-256-GCM, PAYMENT_DATA_KEY) and only decrypted for the owner or staff.
model ApplicationWorkAccount {
  id                String   @id @default(uuid()) @db.Uuid
  applicationId     String   @unique @map("application_id") @db.Uuid
  workEmail         String   @map("work_email") @db.VarChar(254)
  passwordEncrypted String   @map("password_encrypted")
  instructions      String?
  sentAt            DateTime @default(now()) @map("sent_at") @db.Timestamptz()
  sentById          String?  @map("sent_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sentBy      User?                @relation("WorkAccountsSent", fields: [sentById], references: [id], onDelete: SetNull)

  @@map("application_work_accounts")
}

/// One day of work on a project. Rate, currency and unit are copied from the
/// job when submitted, so later pay changes don't alter history. Approved and
/// unpaid (payoutId null) entries make up the candidate's pending payment.
model TimesheetEntry {
  id              String          @id @default(uuid()) @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  jobId           String          @map("job_id") @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  quantity        Decimal         @db.Decimal(8, 2)
  rate            Decimal         @db.Decimal(12, 2)
  currency        PayCurrency
  unit            PayUnit
  amount          Decimal         @db.Decimal(14, 2)
  note            String
  status          TimesheetStatus @default(SUBMITTED)
  rejectionReason String?         @map("rejection_reason")
  reviewedById    String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?       @map("reviewed_at") @db.Timestamptz()
  payoutId        String?         @map("payout_id") @db.Uuid
  /// Screenshot proving the work (required when submitting).
  proofFileId     String?         @map("proof_file_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User                 @relation("TimesheetEntries", fields: [userId], references: [id])
  job         Job                  @relation(fields: [jobId], references: [id])
  reviewedBy  User?                @relation("TimesheetsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  payout      Payout?              @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  proofFile   FileObject?          @relation("TimesheetProof", fields: [proofFileId], references: [id], onDelete: SetNull)

  @@unique([applicationId, workDate])
  @@index([userId, status])
  @@index([jobId, workDate])
  @@index([status])
  @@index([payoutId])
  @@map("timesheet_entries")
}

/// A payment made to a candidate, covering approved timesheet entries.
/// The admin pays outside the app and uploads proof (screenshot).
model Payout {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  amount             Decimal     @db.Decimal(14, 2)
  currency           PayCurrency
  reference          String?     @db.VarChar(120)
  note               String?
  proofFileId        String?     @map("proof_file_id") @db.Uuid
  paymentMethodId    String?     @map("payment_method_id") @db.Uuid
  /// Snapshot, e.g. "UPI name@okhdfcbank" or "Bank ••••1234 (HDFC0001234)"
  paymentMethodLabel String?     @map("payment_method_label") @db.VarChar(200)
  paidById           String?     @map("paid_by_id") @db.Uuid
  paidAt             DateTime    @default(now()) @map("paid_at") @db.Timestamptz()
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  user          User               @relation("PayoutsReceived", fields: [userId], references: [id])
  paidBy        User?              @relation("PayoutsSent", fields: [paidById], references: [id], onDelete: SetNull)
  proofFile     FileObject?        @relation("PayoutProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  paymentMethod UserPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  entries       TimesheetEntry[]

  @@index([userId, paidAt])
  @@map("payouts")
}

/// Community feed post: an admin announcement, or a new project posted from
/// the create-job form. Shown when PUBLISHED and not expired (null = never).
model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  type        AnnouncementType     @default(ANNOUNCEMENT)
  category    AnnouncementCategory @default(GENERAL)
  title       String               @db.VarChar(200)
  body        String
  status      AnnouncementStatus   @default(DRAFT)
  pinned      Boolean              @default(false)
  expiresAt   DateTime?            @map("expires_at") @db.Timestamptz()
  publishedAt DateTime?            @map("published_at") @db.Timestamptz()
  jobId       String?              @map("job_id") @db.Uuid
  createdById String?              @map("created_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  job       Job?                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("AnnouncementsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  reactions AnnouncementReaction[]

  @@index([status, pinned, publishedAt])
  @@index([expiresAt])
  @@index([jobId])
  @@map("announcements")
}

/// One person's Like or Love on a community post (each can be toggled).
model AnnouncementReaction {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           ReactionType
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, type])
  @@index([announcementId, type])
  @@map("announcement_reactions")
}

/// In-app notifications (bell + /notifications) for candidates and admins.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String
  /// In-app path to open, e.g. /projects/applied
  link      String?          @db.VarChar(500)
  readAt    DateTime?        @map("read_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  changedById   String?            @map("changed_by_id") @db.Uuid
  comment       String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?                @relation("ApplicationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model DocumentType {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique @db.VarChar(100)
  name                String   @db.VarChar(200)
  description         String?
  allowedMimeTypes    String[] @default([]) @map("allowed_mime_types")
  maxSizeBytes        Int?     @map("max_size_bytes")
  sensitive           Boolean  @default(false)
  allowCandidateReuse Boolean  @default(false) @map("allow_candidate_reuse")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  applicationFields    JobApplicationField[]
  applicationDocuments JobApplicationDocument[]
  candidateDocuments   CandidateProfileDocument[]

  @@map("document_types")
}

model JobApplicationDocument {
  id                  String                     @id @default(uuid()) @db.Uuid
  applicationId       String                     @map("application_id") @db.Uuid
  documentTypeId      String                     @map("document_type_id") @db.Uuid
  fileObjectId        String                     @map("file_object_id") @db.Uuid
  candidateDocumentId String?                    @map("candidate_document_id") @db.Uuid
  fieldKey            String?                    @map("field_key") @db.VarChar(100)
  version             Int                        @default(1)
  isCurrent           Boolean                    @default(true) @map("is_current")
  verificationStatus  DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt          DateTime?                  @map("verified_at") @db.Timestamptz()
  verifiedById        String?                    @map("verified_by_id") @db.Uuid
  verificationComment String?                    @map("verification_comment")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()

  application       CandidateApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType      DocumentType              @relation(fields: [documentTypeId], references: [id])
  fileObject        FileObject                @relation(fields: [fileObjectId], references: [id])
  candidateDocument CandidateProfileDocument? @relation(fields: [candidateDocumentId], references: [id], onDelete: SetNull)
  verifiedBy        User?                     @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([applicationId, fieldKey])
  @@index([documentTypeId])
  @@index([fileObjectId])
  @@index([candidateDocumentId])
  @@map("job_application_documents")
}

model CandidateProfileField {
  id          String               @id @default(uuid()) @db.Uuid
  key         String               @unique @db.VarChar(100)
  label       String               @db.VarChar(200)
  description String?
  fieldType   ApplicationFieldType @map("field_type")
  isSensitive Boolean              @default(false) @map("is_sensitive")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  values    CandidateProfileValue[]
  jobFields JobApplicationField[]

  @@map("candidate_profile_fields")
}

model CandidateProfileValue {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  field CandidateProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@map("candidate_profile_values")
}

model CandidateProfileDocument {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String                     @map("user_id") @db.Uuid
  documentTypeId     String                     @map("document_type_id") @db.Uuid
  fileObjectId       String                     @unique @map("file_object_id") @db.Uuid
  version            Int                        @default(1)
  isCurrent          Boolean                    @default(true) @map("is_current")
  expiresAt          DateTime?                  @map("expires_at") @db.Timestamptz()
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz()
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()

  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType         DocumentType             @relation(fields: [documentTypeId], references: [id])
  fileObject           FileObject               @relation(fields: [fileObjectId], references: [id])
  applicationDocuments JobApplicationDocument[]

  @@index([userId, documentTypeId, isCurrent])
  @@map("candidate_profile_documents")
}

model JobApplicationFieldValue {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  fieldId       String   @map("field_id") @db.Uuid
  value         Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       JobApplicationField  @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([applicationId, fieldId])
  @@index([fieldId])
  @@map("job_application_field_values")
}

model JobEligibilityRule {
  id           String               @id @default(uuid()) @db.Uuid
  jobId        String               @map("job_id") @db.Uuid
  fieldKey     String               @map("field_key") @db.VarChar(100)
  fieldType    EligibilityFieldType @map("field_type")
  operator     EligibilityOperator
  value        Json
  displayOrder Int                  @default(0) @map("display_order")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz()

