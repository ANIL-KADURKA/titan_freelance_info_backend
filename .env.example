# Supabase transaction pooler for the app (port 6543). Keep connection_limit low.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Session pooler / direct connection for prisma migrate (port 5432).
DIRECT_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://titan-freelance.netlify.app"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="anil.kadurka7@gmail.com"
SMTP_PASS=""
SMTP_FROM="anil.kadurka7@gmail.com"
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Phone OTP is mocked (no SMS is sent): every phone code is this value.
PHONE_OTP_MOCK_CODE="12345"
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts payout account numbers.
PAYMENT_DATA_KEY=
# Used for links in emails (e.g. https://app.titanfreelance.com). Optional.
FRONTEND_URL=
